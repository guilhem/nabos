--- /dev/null
+++ b/src/libnm-core-aux-intern/tests/nabos-auth-subject-test.c
@@ -0,0 +1,46 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#include "libnm-glib-aux/nm-default-glib-i18n-prog.h"
+#include "nm-auth-subject.h"
+
+static void
+check(const char *sender, gboolean system_bus, const char *kind, guint fields)
+{
+    NMAuthSubject *subject;
+    GVariant *serialized, *details;
+    const char *actual, *name = NULL;
+    guint32 pid;
+    guint64 start;
+    gint32 uid;
+
+    subject = nm_auth_subject_new_unix_process(sender, getpid(), getuid(), system_bus);
+    g_assert_nonnull(subject);
+    serialized = g_variant_ref_sink(nm_auth_subject_unix_to_polkit_gvariant(subject));
+    g_variant_get(serialized, "(&s@a{sv})", &actual, &details);
+    g_assert_cmpstr(actual, ==, kind);
+    g_assert_cmpuint(g_variant_n_children(details), ==, fields);
+    if (system_bus) {
+        g_assert_true(g_variant_lookup(details, "name", "&s", &name));
+        g_assert_cmpstr(name, ==, sender);
+        g_assert_false(g_variant_lookup(details, "pid", "u", &pid));
+    } else {
+        g_assert_true(g_variant_lookup(details, "pid", "u", &pid));
+        g_assert_cmpuint(pid, ==, getpid());
+        g_assert_true(g_variant_lookup(details, "start-time", "t", &start));
+        g_assert_cmpuint(start, >, 0);
+        g_assert_true(g_variant_lookup(details, "uid", "i", &uid));
+        g_assert_cmpint(uid, ==, getuid());
+        g_assert_false(g_variant_lookup(details, "name", "&s", &name));
+    }
+    g_variant_unref(details);
+    g_variant_unref(serialized);
+    g_object_unref(subject);
+}
+
+int main(void)
+{
+    check(":1.42", TRUE, "system-bus-name", 1);
+    /* Synthetic private names must not be resolved on the system bus. */
+    check(":1.42", FALSE, "unix-process", 3);
+    check(NULL, FALSE, "unix-process", 3);
+    return 0;
+}
