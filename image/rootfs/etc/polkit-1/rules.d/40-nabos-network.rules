// Network mutations belong to device-core, including when there is no login
// session. Other service accounts cannot fall back to interactive defaults.
polkit.addRule(function (action, subject) {
	if (action.id.indexOf("org.freedesktop.NetworkManager.") !== 0) {
		return polkit.Result.NOT_HANDLED;
	}
	if (subject.user === "device-core" &&
		["network-control", "wifi.scan", "wifi.share.open", "settings.modify.system",
			"checkpoint-rollback"].indexOf(action.id.substring("org.freedesktop.NetworkManager.".length)) >= 0) {
		return polkit.Result.YES;
	}
	return ["device-core", "nab-app", "nab-hardware", "nab-audio"].indexOf(subject.user) >= 0 ?
		polkit.Result.NO : polkit.Result.NOT_HANDLED;
});
