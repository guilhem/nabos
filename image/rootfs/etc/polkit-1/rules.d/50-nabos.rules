// device-core runs as nabos without a login session: allow reboot/power off and
// manual clock setting and runtime jobs for voice/NTP/SSH only.
polkit.addRule(function (action, subject) {
	if (subject.user !== "nabos") {
		return polkit.Result.NOT_HANDLED;
	}
	switch (action.id) {
	case "org.freedesktop.login1.reboot":
	case "org.freedesktop.login1.reboot-multiple-sessions":
	case "org.freedesktop.login1.power-off":
	case "org.freedesktop.login1.power-off-multiple-sessions":
	case "org.freedesktop.timedate1.set-time":
		return subject.system_unit === "device-core.service" && subject.no_new_privileges ?
			polkit.Result.YES : polkit.Result.NO;
	case "org.freedesktop.systemd1.manage-units":
		if (subject.system_unit !== "device-core.service" || !subject.no_new_privileges) {
			return polkit.Result.NO;
		}
		if (action.lookup("unit") === "linux-voice-assistant.service" &&
			["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0) {
			return polkit.Result.YES;
		}
		if (["systemd-timesyncd.service", "ssh.service"].indexOf(action.lookup("unit")) >= 0 &&
			["start", "stop"].indexOf(action.lookup("verb")) >= 0) {
			return polkit.Result.YES;
		}
		return polkit.Result.NO;
	}
	return polkit.Result.NOT_HANDLED;
});
