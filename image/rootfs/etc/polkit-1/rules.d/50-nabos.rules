// The dedicated device-core account may reboot/power off and
// manual clock setting and runtime jobs for voice/NTP/SSH only.
polkit.addRule(function (action, subject) {
	if (subject.user !== "device-core") {
		if (["nab-app", "nab-hardware", "nab-audio"].indexOf(subject.user) >= 0 &&
			["org.freedesktop.login1.", "org.freedesktop.timedate1.", "org.freedesktop.systemd1."].some(function (prefix) {
				return action.id.indexOf(prefix) === 0;
			})) {
			return polkit.Result.NO;
		}
		return polkit.Result.NOT_HANDLED;
	}
	switch (action.id) {
	case "org.freedesktop.login1.reboot":
	case "org.freedesktop.login1.reboot-multiple-sessions":
	case "org.freedesktop.login1.power-off":
	case "org.freedesktop.login1.power-off-multiple-sessions":
	case "org.freedesktop.timedate1.set-time":
		return polkit.Result.YES;
	case "org.freedesktop.systemd1.manage-units":
		if (action.lookup("unit") === "linux-voice-assistant.service" &&
			["start", "stop", "restart"].indexOf(action.lookup("verb")) >= 0) {
			return polkit.Result.YES;
		}
		if (["systemd-timesyncd.service", "ssh.service", "nabos-rauc-manual.service"].indexOf(action.lookup("unit")) >= 0 &&
			["start", "stop"].indexOf(action.lookup("verb")) >= 0) {
			return polkit.Result.YES;
		}
		return polkit.Result.NO;
	}
	return polkit.Result.NOT_HANDLED;
});
