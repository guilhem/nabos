#!/bin/bash
# Build time only: image/prepare.sh finalize runs this inside the target chroot and
# deletes it afterwards. Turns the Raspberry Pi OS tree into the read-only A/B
# image. Packages, kernel staging and the boot partition belong to prepare/build.
set -euo pipefail
[[ -f /etc/rpi-issue && -d /nabos-build ]] || { echo 'Target chroot required' >&2; exit 1; }
[[ $(id -u nabos 2>/dev/null) == 1000 ]] || { echo 'User nabos with uid 1000 is required' >&2; exit 1; }

# The overlay comes from a git checkout: it must not keep the runner's uid or
# group/world-writable modes on any file or on the directories it passes through.
bad=$(cd /nabos-build/image/rootfs && find . -mindepth 1 -printf '/%P\n' | while IFS= read -r path; do
	find "$path" -maxdepth 0 ! -type l \( ! -user root -o -perm /022 \) -print
done)
[[ -z $bad ]] || { printf 'Not root-owned or group/world-writable: %s\n' $bad >&2; exit 1; }

# Device identity is created on first boot by boot-init.
: > /etc/machine-id
mkdir -p /var/lib/dbus
ln -sfn /etc/machine-id /var/lib/dbus/machine-id

# Apply the package rules while /etc is writable. In particular, the overlay
# replaces polkit's rules directory mode and the base may lack the mtab symlink.
systemd-tmpfiles --create --prefix=/etc/mtab --prefix=/etc/polkit-1/rules.d

# Disable cloud-init's generator as well as its units (names change across releases).
mkdir -p /etc/cloud
touch /etc/cloud/cloud-init.disabled

# Remove the inherited swap file while the root is writable; rpi-swap now keeps
# its backing file on /data, mounted and grown by boot-init before systemd.
rm -f /var/swap
# rpi-swap owns these generated units. The generic generator can overwrite its
# loop dependency; keep its binary available for systemd-zram-setup@.service.
mkdir -p /etc/systemd/system-generators
ln -sfn /dev/null /etc/systemd/system-generators/zram-generator

# Mount points for the state boot-init binds from /data (list shared with it).
NABOS_BOOT_INIT_LIB=1 . /usr/lib/nabos/boot-init
mkdir -p /data $PERSIST
# The overlay replaces the package directory mode; persist copies it on first boot.
chmod 0700 /etc/NetworkManager/system-connections /var/lib/NetworkManager
chown nabos:nabos /var/lib/nabos
chmod 0711 /var/lib/nabos
chmod 0440 /etc/sudoers.d/010_nabos-nopasswd

# Advertise Voice only when finalize installed its executable environment.
lva_unit=
if [[ -x /opt/linux-voice-assistant/.venv/bin/python ]]; then
  lva_unit=linux-voice-assistant.service
fi
printf 'DEVICE_CORE_LVA_UNIT=%s\n' "$lva_unit" >> /etc/nabos/release.env

# pi-gen soft-blocks Wi-Fi on some boards until a country is set.
rm -f /var/lib/systemd/rfkill/*
systemctl set-default multi-user.target
systemctl --global enable pipewire.service pipewire.socket pipewire-pulse.service pipewire-pulse.socket wireplumber.service
# No Bluetooth feature is used; remove the D-Bus activation alias before masking.
systemctl disable bluetooth.service
systemctl enable device-core.service nab-hardware.service nabos.service nabos-rfid.service nabos-health.service \
	linux-voice-assistant.service tagtagtag-mixerd.service \
	NetworkManager.service avahi-daemon.service systemd-timesyncd.service ssh.service
# Writers to the read-only root, jobs with nothing to do here, and services that
# would fight NetworkManager or tagtagtag-mixerd (owner of the mixer state).
systemctl mask systemd-rfkill.service systemd-rfkill.socket alsa-restore.service alsa-state.service \
	fake-hwclock.service logrotate.timer man-db.timer e2scrub_all.timer e2scrub_reap.service \
	dpkg-db-backup.timer dphys-swapfile.service sshswitch.service rpi-eeprom-update.service \
	dnsmasq.service dhcpcd.service systemd-networkd.service systemd-growfs-root.service \
	cloud-init-main.service cloud-init-network.service bluetooth.service
