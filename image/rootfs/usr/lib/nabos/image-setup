#!/bin/bash
# Build time only: image/prepare.sh finalize runs this inside the target chroot and
# deletes it afterwards. Turns the Raspberry Pi OS tree into the read-only A/B
# image. Packages, kernel staging and the boot partition belong to prepare/build.
set -euo pipefail
[[ -f /etc/rpi-issue && -d /nabos-build ]] || { echo 'Target chroot required' >&2; exit 1; }
[[ $(id -u nabos 2>/dev/null) == 1000 ]] || { echo 'User nabos with uid 1000 is required' >&2; exit 1; }

# The overlay comes from a git checkout: it must not keep the runner's uid or
# group/world-writable modes on any file or on the directories it passes through.
bad=$(cd /nabos-build/image/rootfs && find . -mindepth 1 -printf '/%P\n' | while IFS= read -r path; do
	find "$path" -maxdepth 0 ! -type l \( ! -user root -o -perm /022 \) -print
done)
[[ -z $bad ]] || { printf 'Not root-owned or group/world-writable: %s\n' $bad >&2; exit 1; }

# Device identity is created on first boot by boot-init.
: > /etc/machine-id
mkdir -p /var/lib/dbus
ln -sfn /etc/machine-id /var/lib/dbus/machine-id

# Mount points for the state boot-init binds from /data (list shared with it).
NABOS_BOOT_INIT_LIB=1 . /usr/lib/nabos/boot-init
mkdir -p /data $PERSIST
chmod 0700 /etc/NetworkManager/system-connections
chown nabos:nabos /var/lib/nabos
chmod 0700 /var/lib/nabos
chmod 0440 /etc/sudoers.d/010_nabos-nopasswd

# pi-gen soft-blocks Wi-Fi on some boards until a country is set; comitup owns Wi-Fi.
rm -f /var/lib/systemd/rfkill/*

ln -sfn /usr/share/zoneinfo/Europe/Paris /etc/localtime
echo Europe/Paris > /etc/timezone

systemctl set-default multi-user.target
systemctl --global enable pipewire.service pipewire.socket pipewire-pulse.service pipewire-pulse.socket wireplumber.service
systemctl enable nab-core.service nab-service.service nabos-rfid.service nabos-health.service \
	linux-voice-assistant.service tagtagtag-mixerd.service mosquitto.service \
	NetworkManager.service comitup.service avahi-daemon.service systemd-timesyncd.service ssh.service
# Writers to the read-only root, jobs with nothing to do here, and services that
# would fight NetworkManager/comitup or tagtagtag-mixerd (owner of the mixer state).
systemctl mask systemd-rfkill.service systemd-rfkill.socket alsa-restore.service alsa-state.service \
	fake-hwclock.service logrotate.timer man-db.timer e2scrub_all.timer e2scrub_reap.service \
	dpkg-db-backup.timer dphys-swapfile.service sshswitch.service rpi-eeprom-update.service \
	dnsmasq.service dhcpcd.service systemd-networkd.service
