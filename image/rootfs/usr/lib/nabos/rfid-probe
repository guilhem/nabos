#!/bin/sh
# TagTagTag (CR14) and 2022 NFC card (ST25R391x) readers share I2C address 0x50
# and their drivers conflict. Identify the chip before loading
# the matching overlay from the running slot's /boot/overlays.
set -u
modprobe i2c-dev
reg() { i2cget -y 1 0x50 "$1" b 2> /dev/null; }
if [ "$(reg 0x7f)" = 0x2a ]; then
	overlay=st25r391x
elif [ "$(reg 0x00)" = 0x00 ]; then
	overlay=cr14
else
	echo "no RFID reader answers at i2c-1 0x50"
	exit 0
fi
echo "loading the $overlay overlay"
exec dtoverlay -d /boot/overlays "$overlay"
