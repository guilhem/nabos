[Unit]
Description=Nabaztag application service (HTTP :80, MQTT)
Wants=mosquitto.service user@1000.service device-core.service
After=mosquitto.service user@1000.service device-core.service

[Service]
Type=exec
User=nabos
Group=nabos
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/var/lib/nabos
Environment=NABOS_HTTP_ADDR=:80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
EnvironmentFile=/etc/nabos/release.env
RuntimeDirectory=nab-service
WorkingDirectory=/run/nab-service
ExecStart=/usr/bin/nab-service
Restart=always
RestartSec=2
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/nabos

[Install]
WantedBy=multi-user.target
