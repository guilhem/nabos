[Unit]
Description=Nabaztag application (states, media, choreography, HTTP :80)
Wants=device-core.service nab-hardware.service
After=systemd-tmpfiles-setup.service device-core.service nab-hardware.service

[Service]
Type=exec
User=nab-app
Group=nab-app
Environment=XDG_RUNTIME_DIR=/run/nabos
Environment=HOME=/data/nabos
Environment=NABOS_DATA_DIR=/data/nabos
Environment=NABOS_HTTP_ADDR=:80
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
EnvironmentFile=/etc/nabos/release.env
RuntimeDirectory=nabos
WorkingDirectory=/run/nabos
ExecStart=/usr/bin/nabos
Restart=always
RestartSec=2
UMask=0027
NoNewPrivileges=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/data/nabos

[Install]
WantedBy=multi-user.target
