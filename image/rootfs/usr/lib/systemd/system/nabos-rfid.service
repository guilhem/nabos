[Unit]
Description=Detect the RFID/NFC reader and load its overlay
ConditionPathExists=!/dev/rfid0
ConditionPathExists=!/dev/nfc0
After=systemd-modules-load.service sys-kernel-config.mount
Before=nab-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/nabos/rfid-probe

[Install]
WantedBy=multi-user.target
