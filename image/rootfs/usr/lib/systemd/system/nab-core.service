[Unit]
Description=Nabaztag core (hardware and choreography)
Wants=mosquitto.service user@1000.service device-core.service
After=mosquitto.service user@1000.service nabos-rfid.service tagtagtag-mixerd.service device-core.service

[Service]
Type=exec
User=nabos
Group=nabos
# rpi_ws281x drives PWM+DMA through /dev/mem (kmem, see 60-nabos.rules) and
# /dev/vcio (video): root-equivalent access, confined to this unit.
SupplementaryGroups=gpio video kmem audio
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=HOME=/var/lib/nabos
RuntimeDirectory=nab-core
WorkingDirectory=/run/nab-core
ExecStart=/usr/bin/nab-core
Restart=always
RestartSec=2
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data/nabos

[Install]
WantedBy=multi-user.target
