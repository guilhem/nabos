[Unit]
Description=Nabaztag hardware (D-Bus)
Requires=dbus.socket dev-i2c\x2d1.device sys-class-leds-multi:indicator\x2d0.device sys-class-leds-multi:indicator\x2d1.device sys-class-leds-multi:indicator\x2d2.device sys-class-leds-multi:indicator\x2d3.device sys-class-leds-multi:indicator\x2d4.device
Wants=device-core.service
After=sys-class-leds-multi:indicator\x2d0.device sys-class-leds-multi:indicator\x2d1.device sys-class-leds-multi:indicator\x2d2.device sys-class-leds-multi:indicator\x2d3.device sys-class-leds-multi:indicator\x2d4.device systemd-tmpfiles-setup.service tagtagtag-mixerd.service device-core.service dbus.socket dev-i2c\x2d1.device

[Service]
Type=notify
NotifyAccess=main
User=nab-hardware
Group=nab-hardware
SupplementaryGroups=gpio
CapabilityBoundingSet=
Environment=HOME=/run/nab-hardware
RuntimeDirectory=nab-hardware
WorkingDirectory=/run/nab-hardware
ExecStart=/usr/bin/nab-hardware
ExecStopPost=/usr/bin/nab-hardware --stop-hardware
WatchdogSec=1s
WatchdogSignal=SIGKILL
KillMode=control-group
# Admitted NFC writes have their own five-second physical budget.
TimeoutStopSec=6s
Restart=always
RestartSec=2
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/sys/class/leds/multi:indicator-0/brightness /sys/class/leds/multi:indicator-0/multi_intensity /sys/class/leds/multi:indicator-1/brightness /sys/class/leds/multi:indicator-1/multi_intensity /sys/class/leds/multi:indicator-2/brightness /sys/class/leds/multi:indicator-2/multi_intensity /sys/class/leds/multi:indicator-3/brightness /sys/class/leds/multi:indicator-3/multi_intensity /sys/class/leds/multi:indicator-4/brightness /sys/class/leds/multi:indicator-4/multi_intensity /sys/class/leds/multi:indicator-0/sync

[Install]
WantedBy=multi-user.target
