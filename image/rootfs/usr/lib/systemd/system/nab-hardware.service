[Unit]
Description=Nabaztag hardware (D-Bus)
Requires=dbus.socket dev-i2c\x2d1.device
Wants=device-core.service
After=systemd-tmpfiles-setup.service tagtagtag-mixerd.service device-core.service dbus.socket dev-i2c\x2d1.device

[Service]
Type=notify
NotifyAccess=main
User=nab-hardware
Group=nab-hardware
# rpi_ws281x drives PWM+DMA through /dev/mem (kmem, see 60-nabos.rules) and
# /dev/vcio (video): root-equivalent access, confined to this unit.
SupplementaryGroups=gpio video kmem
AmbientCapabilities=CAP_SYS_RAWIO
CapabilityBoundingSet=CAP_SYS_RAWIO
Environment=HOME=/run/nab-hardware
RuntimeDirectory=nab-hardware
WorkingDirectory=/run/nab-hardware
ExecStart=/usr/bin/nab-hardware
ExecStopPost=/usr/bin/nab-hardware --stop-ears
WatchdogSec=1s
WatchdogSignal=SIGKILL
KillMode=control-group
# Admitted NFC writes have their own five-second physical budget.
TimeoutStopSec=6s
Restart=always
RestartSec=2
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
