# Complete stored U-Boot environment, packed by image/build.sh with
#   mkenvimage -r -s 0x10000 (comment lines stripped).
# A valid stored environment REPLACES U-Boot's built-in one, so everything the
# boot needs is here, not only the A/B state. Addresses are those of the pinned
# board/raspberrypi/rpi/rpi.env; the console is serial only (headless).
bootcmd=load mmc 0:1 ${scriptaddr} boot.scr && source ${scriptaddr}
bootdelay=-2
stdin=serial
stdout=serial
stderr=serial
bootm_size=0x20000000
kernel_addr_r=0x00080000
kernel_comp_addr_r=0x02000000
kernel_comp_size=0x03400000
scriptaddr=0x05400000
pxefile_addr_r=0x05500000
fdt_addr_r=0x05600000
ramdisk_addr_r=0x05700000
# Restrict automatic discovery to the SD card and native RAUC method.
boot_targets=mmc0
bootmeths=rauc
