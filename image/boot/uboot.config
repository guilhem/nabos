# Merged with layout.config into the pinned Raspberry Pi defconfig.
# Headless: boot at once, and never stop at a prompt because of UART noise.
CONFIG_BOOTDELAY=-2
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="load mmc 0:1 ${scriptaddr} boot.scr && source ${scriptaddr}"
CONFIG_BOOTSTD=y
CONFIG_BOOTSTD_FULL=y
CONFIG_CMD_BOOTMETH=y
CONFIG_CMD_IMI=y
CONFIG_OF_LIBFDT_OVERLAY=y
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_NVEDIT_LOAD=y
CONFIG_NABOS_RECOVERY=y
# Arm immediately before the kernel handoff; Linux then takes over servicing.
CONFIG_WDT=y
CONFIG_WDT_BCM2835=y
CONFIG_WATCHDOG=y
CONFIG_CMD_WDT=y
# CONFIG_WATCHDOG_AUTOSTART is not set
# RAUC installs root filesystems; no UEFI capsule generator is needed on the host.
# CONFIG_TOOLS_MKEFICAPSULE is not set
